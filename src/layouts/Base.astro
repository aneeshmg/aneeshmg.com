---
import "../styles/global.css";
import { boredSites, person } from "../data/site";

interface Props {
  title?: string;
  description?: string;
  // "shapes": the home page's morphing particles. "ambient": the glow, wash and dust only.
  scene?: "shapes" | "ambient";
  // Practice whose colour tints the glow and wash on ambient pages (and before the scene loads).
  tint?: string;
}

const {
  title = `${person.name}: engineer, trainer, author, maker`,
  description = `${person.name} is a software engineer, certified fitness professional, author of Optimal Living, and maker of AuraByAneeshMG skincare.`,
  scene = "ambient",
  tint = "neutral",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const bored = await boredSites();
---

<!doctype html>
<html lang="en" data-tint={tint}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f1f1ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08090a" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      // Before first paint: the saved theme, else the system setting; reveal-on-entry only when motion is allowed.
      const r = document.documentElement;
      try { r.dataset.theme = localStorage.getItem("theme") || ""; } catch {}
      if (!r.dataset.theme) r.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        r.classList.add("js");
        setTimeout(() => window.__site || r.classList.remove("js"), 2500);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wash" aria-hidden="true"></div>
    <div class="glow" aria-hidden="true"></div>
    <canvas id="gl" data-scene={scene} aria-hidden="true"></canvas>
    <header class="nav">
      <a class="brand" href="/">{person.short}</a>
      <div class="right">
        <button class="pill bored" type="button" data-bored={JSON.stringify(bored)}>I'm bored</button>
        <button class="pill theme" type="button" aria-label="Switch to dark mode">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
        </button>
      </div>
      <p class="sr" aria-live="polite" data-bored-note></p>
    </header>

    <main id="main">
      <slot />
    </main>

    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
