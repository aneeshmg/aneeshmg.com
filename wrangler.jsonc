{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aneeshmg-com",
  "compatibility_date": "2026-10-01",
  // No Worker script: the whole site is static assets.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "aneeshmg.com", "custom_domain": true }]
}
